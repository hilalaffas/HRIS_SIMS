# Salin ke .env (jangan commit .env). Variabel VITE_* TERLIHAT di browser.

# URL backend Spring Boot
VITE_API_URL=http://localhost:8080

# [BARU] Key Google Maps Embed API untuk peta di popup absen Dashboard.
# Kosong = peta memakai OpenStreetMap. Wajib dibatasi di Google Cloud Console:
#   - Application restriction: HTTP referrers (domain Vercel + http://localhost:5173/*)
#   - API restriction: Maps Embed API saja
VITE_GOOGLE_MAPS_EMBED_KEY=
